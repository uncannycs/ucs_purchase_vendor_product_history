<odoo>
  <data>
  <!--    Purchase order form view inherited to add fields-->
    <record model="ir.ui.view" id="purchase_order_form_inherit">
      <field name="name">purchase.purchase.order.form</field>
      <field name="model">purchase.order</field>
      <field name="inherit_id" ref="purchase.purchase_order_form" />
      <field name="arch" type="xml">
          <xpath expr="//field[@name='order_line']/list//field[@name='product_id']" position="before">
               <button name="get_purchase_product_history_data" type="object" title="History" icon="fa-history"/>
          </xpath>
      </field>
    </record>
  </data>
</odoo>
